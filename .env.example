# 服务端模型配置；复制为 .env 并填写。真实密钥只放在这里，不会进入快照、数据库或报告。
#
# 审计应用支持一组别名（LLM_* 优先，其次是 AUDIT_*，最后是 OPENAI_*），
# 这样可以直接复用其它项目已有的 OpenAI 兼容配置。

# 模型名，例如 deepseek-flash / ark-code-latest / gpt-4.1-mini
# 若只设置 DEEPSEEK_API_KEY，默认使用 DeepSeek 官方 deepseek-flash。
LLM_MODEL=deepseek-flash
# OpenAI 兼容服务的 API 根地址；仅设置 DEEPSEEK_API_KEY 时默认使用
# https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
# API Key
LLM_API_KEY=
# DeepSeek 官方 API key；也可只在运行环境中设置，不必保存到此文件。
DEEPSEEK_API_KEY=
# 可选：disabled（默认）会显式关闭思维链输出，避免推理内容占满响应预算。
LLM_THINKING=disabled

# 可选：本地启动时的数据目录；Compose 内固定为 /app/data。
AUDIT_DATA_DIR=./data

# 演示靶机 DVWA 的数据库口令（仅用于 compose 内的 mysql 与 dvwa 两个服务）。
DVWA_DB_PASSWORD=vulnerables
