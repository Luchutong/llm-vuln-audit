# 服务端模型配置；复制为 .env 并填写。真实密钥只放在这里，不会进入快照、数据库或报告。
#
# 审计应用支持一组别名（LLM_* 优先，其次是 AUDIT_*，最后是 OPENAI_*），
# 这样可以直接复用其它项目已有的 OpenAI 兼容配置。

# 模型名，例如 ark-code-latest / deepseek-chat / gpt-4.1-mini
LLM_MODEL=
# OpenAI 兼容服务的 API 根地址，例如 https://ark.cn-beijing.volces.com/api/plan/v3
LLM_BASE_URL=
# API Key
LLM_API_KEY=
# 可选：disabled（默认）会显式关闭思维链输出，避免推理内容占满响应预算。
LLM_THINKING=disabled

# 可选：本地启动时的数据目录；Compose 内固定为 /app/data。
AUDIT_DATA_DIR=./data

# ---------------------------------------------------------------------------
# 上下文控制（阶段内历史窗口）
#
# 宿主按「本次请求序列化后的 UTF-8 字节」控制模型上下文，字节不等于 token：中文约 3 字节/字，
# 384KiB 可能对应十万级 token。接近上限时，较早步骤会被模型摘要替代（摘要不是源码证据），
# 摘要预算不足或失败时改用确定性裁剪；只有压缩后仍超限才会以 context_limit 结束阶段。
# 非法值会让进程启动失败，而不是静默回退。详见 docs/context-control.md。
# 全部数值为默认值，按需取消注释。
# 单次请求硬上限（64KiB..2MiB）；换用窗口更小的模型时必须下调。
# AUDIT_HISTORY_BYTES=393216
# 1=允许 LLM 摘要压缩；0=只做确定性裁剪（不花模型请求）。
# AUDIT_HISTORY_SUMMARY=1
# 摘要消息本身的硬上限（512B..16KiB）。
# AUDIT_HISTORY_SUMMARY_BYTES=4096
# 送去摘要的旧历史先裁剪到这个大小（8KiB..128KiB）。
# AUDIT_HISTORY_SUMMARY_INPUT_BYTES=49152
# 摘要请求的输出上限（256..8192）；该请求禁用思维链。
# AUDIT_HISTORY_SUMMARY_MAX_TOKENS=1536
# 每个阶段 / 整次运行允许的摘要请求数；摘要请求计入 responses 预算。
# AUDIT_HISTORY_SUMMARY_RESPONSES=2
# AUDIT_HISTORY_SUMMARY_RUN_RESPONSES=8
# 确定性裁剪时旧 assistant 动作 / observation 保留的头部字节。
# AUDIT_HISTORY_ACTION_BYTES=2048
# AUDIT_HISTORY_OBSERVATION_BYTES=1024
# 其余输出与读取上限；含义见 docs/context-control.md。
# AUDIT_PLANNER_PINNED_BYTES=16384
# AUDIT_PLANNER_PINNED_HARD_BYTES=32768
# AUDIT_SOURCE_BYTES=65536
# AUDIT_TOOL_BYTES=16384
# AUDIT_CODE_OUTPUT_BYTES=24576
# AUDIT_PLANNER_MAX_TOKENS=8192
# AUDIT_WORKER_MAX_TOKENS=4096
# AUDIT_RECON_MAX_TOKENS=2048
# AUDIT_POC_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# POC 自动验证（可选）
#
# COMPOSE_PROFILES=poc 会让 `docker compose up` 同时启动本地 Lab30 商城、MariaDB 与合作服务
# 和隔离的 poc-runner。删掉这一行（或留空）即回到只有审计应用的栈：POC 关闭，
# 每条漏洞在报告里标注「未验证」，run 仍会正常收束。
COMPOSE_PROFILES=poc

# runner 的共享令牌。runner 要求 Bearer 认证；请改成本机随机值，并与应用共用。
# 生成示例：openssl rand -hex 32
POC_RUNNER_TOKEN=change-me-local-runner-token

# 1=启用自动验证；0=即使栈里有 runner 也不调用。
POC_ENABLED=1
# 1=要求每条 standing 漏洞都有自动验证结论才能 `met`；默认 0（未验证也允许收束）。
POC_REQUIRED=0
# 目标固定为 lab30；旧 POC_TARGET 环境变量不再影响新任务。
# Compose 内应用通过服务名访问 runner。本地直接跑后端时不要发布端口（runner 只在
# internal 网络上），可用 `./scripts/start.sh --poc` 自动解析 runner 的私有地址；
# 手工启动时从 `docker inspect` 取 poc-control 网络地址后设置 POC_RUNNER_URL。
POC_RUNNER_URL=http://poc-runner:8080
# 1=在 runner 镜像内安装 Playwright/Chromium（XSS 真实验证需要）；0=镜像更小，
# XSS 类结论只能记为 inconclusive。
POC_BROWSER=1
POC_JOB_SECONDS=30

# 每条 finding 的自动验证前复位靶场。开关可以随 run 请求冻结，命令只取服务端环境，
# 请求方永远不能注入命令。复位会清空 Lab30 的业务数据、会话和文件（种子行为），
# 只应在自动审计的 finding 间隙启用；需要保留现场时设为 0。
# `./scripts/start.sh --poc` 默认把这两项设为 1 与本仓库脚本路径。
POC_RESET_BETWEEN_FINDINGS=0
# 复位脚本输出一行 JSON（accounts/drift/ok），退出码 1 表示种子不符。
POC_LAB30_RESET_COMMAND=
POC_RESET_TIMEOUT=30

# 可选加固：逗号分隔的 runner 容器地址/CIDR。设置后，来自这些地址的 /api/* 请求
# 会被应用拒绝（poc-control 网络之外还有一层应用级兜底）。
POC_RUNNER_ADDRS=

# 启动时把随仓库提供的 Lab30 源码包登记为「即可审计」项目，按归档摘要幂等，重启不会重复创建。
# 设为 0 保留空的源码包库；LAB30_SOURCE_ZIP 可指向别处放置的同一份源码包。
LAB30_SEED=1
LAB30_SOURCE_ZIP=

# Lab30 源码及固定版本基础镜像随仓库提供；18880 只绑定本机。
LAB30_PORT=18880
# Host-side scripts/start.sh --poc reaches the runner through this loopback-only proxy.
POC_RUNNER_DEV_PORT=18089
LAB30_DB_ROOT_PASSWORD=change-me-local-lab30-root
LAB30_DB_PASSWORD=change-me-local-lab30
# 默认普通会员；与商城初始数据对应。脚本从 runner 子进程环境读取。
LAB30_USER=alice
LAB30_PASSWORD=Alice123!
# 可选：仅在构建商城 PHP 镜像时使用，不注入运行容器。
SHOP_BUILD_HTTP_PROXY=
SHOP_BUILD_HTTPS_PROXY=
