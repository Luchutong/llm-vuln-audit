  "T2_manual_whitebox": {
    "description": "成员 C 独立阅读核心模块源码做人工白盒标注，覆盖净化、认证、输入过滤、会话四类安全机制；与 T1 来源独立，用于交叉核对 LLM 结论。下列坐标均对冻结归档逐行核对。",
    "modules": [
      {
        "id": "T2-001",
        "module": "数据库抽象层（MySQLi 驱动）",
        "file": "phpmyfaq/src/phpMyFAQ/Database/Mysqli.php",
        "role": "SQL 字符串转义与查询执行",
        "findings": [
          {"line": 116, "symbol": "Mysqli::escape", "kind": "sanitizer", "detail": "内部调用 mysqli::real_escape_string()，是项目标准 SQL 字符串净化入口。"},
          {"line": 299, "symbol": "Mysqli::query", "kind": "execution", "detail": "经 mysqli::query() 单语句执行，不支持多语句堆叠；这决定 CVE-2026-46364 只能时间盲注。"}
        ],
        "security_note": "正确使用 escape 可阻断常规 SQL 注入；但 real_escape_string 不处理 LIKE 通配符（CVE-2026-34973 的根因，4.1.1 已修复）。"
      },
      {
        "id": "T2-002",
        "module": "数据库认证",
        "file": "phpmyfaq/src/phpMyFAQ/Auth/AuthDatabase.php",
        "role": "登录/口令校验",
        "findings": [
          {"line": 62, "symbol": "AuthDatabase::create", "kind": "sanitizer", "detail": "login/password/domain 全部经 databaseDriver->escape() 后再拼入 INSERT。"},
          {"line": 158, "symbol": "AuthDatabase::checkCredentials", "kind": "sanitizer", "detail": "登录名经 escape() 后查询，防止登录框 SQL 注入。"},
          {"line": 181, "symbol": "AuthDatabase::checkCredentials", "kind": "password_check", "detail": "口令经 setSalt(login)->encrypt(password) 加盐加密后用 !== 比较，不存明文、不回退明文。"}
        ],
        "security_note": "与 BuiltinCaptcha 形成直接对照：认证模块所有用户输入均 escape，而验证码模块遗漏，是 T1 漏洞的关键判据。"
      },
      {
        "id": "T2-003",
        "module": "输入过滤",
        "file": "phpmyfaq/src/phpMyFAQ/Filter.php",
        "role": "XSS/输入净化（ext/filter 封装）",
        "findings": [
          {"line": 39, "symbol": "Filter::filterInput", "kind": "wrapper", "detail": "封装 filter_input，按指定过滤器读取外部输入。"},
          {"line": 124, "symbol": "Filter::filterSanitizeString", "kind": "sanitizer", "detail": "htmlspecialchars（ENT_QUOTES）转义 HTML 特殊字符。"},
          {"line": 130, "symbol": "Filter::filterSanitizeString", "kind": "sanitizer", "detail": "preg_replace 去除 NUL 字节与残留标签。"},
          {"line": 131, "symbol": "Filter::filterSanitizeString", "kind": "sanitizer", "detail": "单/双引号替换为 HTML 实体。"}
        ],
        "security_note": "Filter 面向 XSS 防护；SQL 上下文必须改用 Database::escape，二者不可混用。"
      },
      {
        "id": "T2-004",
        "module": "会话与 CSRF 令牌",
        "file": "phpmyfaq/src/phpMyFAQ/Session/Token.php",
        "role": "CSRF 令牌生成与校验",
        "findings": [
          {"line": 190, "symbol": "Token::setSession", "kind": "random", "detail": "令牌由 md5(base64_encode(random_bytes(32))) 生成，使用 CSPRNG，不可预测。"},
          {"line": 154, "symbol": "Token::verifyToken", "kind": "timing_safe", "detail": "用 hash_equals() 做时序安全比较，同时校验 session 与 cookie 双重令牌。"},
          {"line": 148, "symbol": "Token::verifyToken", "kind": "expiry", "detail": "校验提交窗口，过期令牌立即移除并拒绝。"}
        ],
        "security_note": "CSRF 防护实现规范；但公开的 /api/captcha 路由不经过该令牌校验，因此 CVE-2026-46364 无需 CSRF 即可触发。"
      }
    ]
  },

